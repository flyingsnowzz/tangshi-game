{
  "description": "古诗文闯关 · 唐诗/宋词/古文三轨 · 原生微信小程序",
  "packOptions": {
    "ignore": [
      {
        "type": "folder",
        "value": ".workbuddy"
      },
      {
        "type": "folder",
        "value": "docs"
      },
      {
        "type": "suffix",
        "value": ".md"
      },
      {
        "type": "suffix",
        "value": ".sh"
      }
    ],
    "include": []
  },
  "setting": {
    "bundle": false,
    "es6": true,
    "minified": true,
    "postcss": true,
    "urlCheck": true
  },
  "compileType": "miniprogram",
  "appid": "touristappid",
  "projectname": "workbuddy-native-basic",
  "miniprogramRoot": "./"
}

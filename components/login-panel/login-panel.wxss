/* 登录组件 · 少年国风配色（逻辑沿用官方资产，仅换皮） */
.login {
    padding: 32rpx 28rpx;
    background: #fffaf0;
    border: 3rpx solid #f0d79a;
    border-radius: 26rpx;
    box-shadow: 0 6rpx 0 #f4e3ba;
}

.login-title {
    display: block;
    font-size: 34rpx;
    font-weight: 800;
    letter-spacing: 2rpx;
    color: #2b3a35;
}

.login-desc {
    display: block;
    margin-top: 12rpx;
    font-size: 23rpx;
    line-height: 1.7;
    color: #8a7b5c;
}

.login-input {
    height: 88rpx;
    padding: 0 24rpx;
    margin-top: 26rpx;
    font-size: 27rpx;
    color: #2b3a35;
    background: #ffffff;
    border: 3rpx solid #f0e5cd;
    border-radius: 22rpx;
}

.login-placeholder {
    color: #9aa39b;
}

.login-row {
    display: flex;
    align-items: center;
}

.login-code {
    flex: 1;
    margin-top: 18rpx;
}

.login-send {
    flex-shrink: 0;
    margin: 18rpx 0 0 18rpx;
    padding: 0 22rpx;
    height: 88rpx;
    line-height: 88rpx;
    font-size: 24rpx;
    font-weight: 800;
    color: #ffffff;
    background: #f5a340;
    border: 3rpx solid #f5a340;
    border-radius: 22rpx;
    box-shadow: 0 5rpx 0 #d9862a;
}

.login-send-disabled {
    color: #9aa39b;
    background: #f4ecdb;
    border-color: #f0e5cd;
    box-shadow: 0 5rpx 0 #eae2d0;
}

.login-button {
    margin-top: 28rpx;
    height: 92rpx;
    line-height: 86rpx;
    font-size: 30rpx;
    font-weight: 800;
    letter-spacing: 2rpx;
    color: #ffffff;
    background: #2f9e8f;
    border: 3rpx solid #2f9e8f;
    border-radius: 46rpx;
    box-shadow: 0 6rpx 0 #207a6e;
}

.login-button::after {
    border: none;
}

.login-tip {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #207a6e;
}

.login-error {
    display: block;
    margin-top: 20rpx;
    font-size: 24rpx;
    color: #c14c3d;
}

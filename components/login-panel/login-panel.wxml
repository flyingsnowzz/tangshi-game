<view class="login">
    <text class="login-title">用邮箱存成绩</text>
    <text class="login-desc">填一个常用邮箱，收个验证码就存好啦。星星、积分和诗签，换手机也还在。</text>

    <input
        class="login-input"
        type="text"
        placeholder="邮箱"
        placeholder-class="login-placeholder"
        value="{{email}}"
        bindinput="onEmailInput"
    />

    <view class="login-row">
        <input
            class="login-input login-code"
            placeholder="验证码"
            placeholder-class="login-placeholder"
            value="{{code}}"
            bindinput="onCodeInput"
            bindconfirm="submit"
        />
        <view
            class="login-send {{sending || countdown > 0 ? 'login-send-disabled' : ''}}"
            bindtap="sendCode"
        >{{countdown > 0 ? countdown + ' 秒后重发' : (sending ? '发送中' : '获取验证码')}}</view>
    </view>

    <button class="login-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">存好我的成绩</button>

    <text class="login-tip" wx:if="{{tip}}">{{tip}}</text>
    <text class="login-error" wx:if="{{error}}">{{error}}</text>
</view>

<view class="sheet-mask" wx:if="{{open}}" bindtap="onClose">
    <view class="sheet" catchtap="noop">
        <view class="sheet-badge">诗</view>
        <text class="sheet-title">把成绩存起来</text>
        <text class="sheet-desc">登录后，星星、积分和诗签换设备也能接着用</text>
        <login-panel bind:signedin="onSignedIn" />
        <view class="sheet-skip" bindtap="onClose">先不登录，继续玩</view>
    </view>
</view>

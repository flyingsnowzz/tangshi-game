/* 设置 · 少年国风：贴纸分组、大字字体档、彩色账号徽章 */
.settings {
    padding-top: 24rpx;
}

.settings-head {
    display: flex;
    flex-direction: column;
    margin-bottom: 36rpx;
}

.settings-sub {
    margin-top: 12rpx;
    font-size: 24rpx;
    color: #8a8b80;
}

.setting-group {
    box-sizing: border-box;
    padding: 4rpx 28rpx;
    background: #ffffff;
    border: 3rpx solid #f0e5cd;
    border-radius: 28rpx;
    box-shadow: 0 7rpx 0 #f4ead5;
}

.setting-row {
    display: flex;
    align-items: center;
    padding: 28rpx 0;
    border-bottom: 2rpx dashed #f0e5cd;
}

.setting-row:last-child {
    border-bottom: none;
}

.setting-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding-right: 20rpx;
}

.setting-name {
    font-size: 28rpx;
    font-weight: 800;
    color: #2b3a35;
}

.setting-desc {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #8a8b80;
    line-height: 1.5;
}

.font-head {
    margin-top: 42rpx;
}

.font-group {
    box-sizing: border-box;
    padding: 28rpx;
    background: #ffffff;
    border: 3rpx solid #f0e5cd;
    border-radius: 28rpx;
    box-shadow: 0 7rpx 0 #f4ead5;
}

.font-row {
    display: flex;
    gap: 16rpx;
}

.font-option {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 22rpx 8rpx;
    background: #fffaf0;
    border: 3rpx solid #f0e5cd;
    border-radius: 22rpx;
    box-shadow: 0 5rpx 0 #f4ead5;
}

.font-on {
    background: #e2f5ef;
    border-color: #2f9e8f;
    box-shadow: 0 5rpx 0 #c6ecdf;
}

.font-name {
    font-size: 32rpx;
    font-weight: 800;
    color: #3f5149;
}

.font-on .font-name {
    color: #207a6e;
}

.font-desc {
    margin-top: 8rpx;
    font-size: 20rpx;
    color: #8a8b80;
}

.preview-label {
    display: block;
    font-size: 22rpx;
    font-weight: 700;
    color: #f5a340;
}

.preview-line {
    display: block;
    margin-top: 12rpx;
    text-align: center;
    color: #2b3a35;
    letter-spacing: 6rpx;
    line-height: 1.7;
}

/* 成绩存放状态 */
.account-box {
    box-sizing: border-box;
    padding: 26rpx;
    background: #fff8e6;
    border: 3rpx dashed #f0c46a;
    border-radius: 28rpx;
}

.account-row {
    display: flex;
    align-items: center;
}

.account-icon {
    flex-shrink: 0;
    width: 72rpx;
    height: 72rpx;
    line-height: 72rpx;
    text-align: center;
    margin-right: 22rpx;
    font-size: 30rpx;
    font-weight: 800;
    color: #ffffff;
    border-radius: 20rpx;
}

.account-icon-guest {
    background: #f5a340;
    box-shadow: 0 5rpx 0 #d9862a;
}

.account-icon-cloud {
    background: #2f9e8f;
    box-shadow: 0 5rpx 0 #207a6e;
}

.account-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.account-name {
    font-size: 29rpx;
    font-weight: 800;
    color: #2b3a35;
}

.account-desc {
    margin-top: 8rpx;
    font-size: 23rpx;
    color: #8a7b5c;
    line-height: 1.6;
}

.account-btn {
    flex-shrink: 0;
    height: 72rpx;
    line-height: 68rpx;
    padding: 0 24rpx;
    font-size: 25rpx;
    font-weight: 700;
    color: #c14c3d;
    background: #ffffff;
    border: 3rpx solid #f3c7bd;
    border-radius: 36rpx;
}

/* 关于 */
.about-box {
    box-sizing: border-box;
    margin-top: 40rpx;
    padding: 28rpx;
    background: #e2f5ef;
    border: 3rpx solid #8fd3c4;
    border-radius: 28rpx;
    box-shadow: 0 7rpx 0 #c6ecdf;
}

.about-title {
    display: block;
    font-size: 28rpx;
    font-weight: 800;
    color: #207a6e;
}

.about-text {
    display: block;
    margin-top: 14rpx;
    font-size: 24rpx;
    color: #4d7a6d;
    line-height: 1.8;
}

/* 声音设置状态卡：让开关的效果可见、可试听 */
.sound-status {
    box-sizing: border-box;
    margin-top: 22rpx;
    padding: 24rpx 28rpx;
    background: #fff3dc;
    border: 3rpx dashed #f0c46a;
    border-radius: 24rpx;
    text-align: center;
}

.sound-status-line {
    display: block;
    font-size: 26rpx;
    font-weight: 800;
    color: #a8631b;
    line-height: 1.6;
}

.sound-try {
    display: inline-block;
    margin: 18rpx auto 0;
    padding: 12rpx 36rpx;
    font-size: 26rpx;
    font-weight: 800;
    color: #ffffff;
    background: #2f9e8f;
    border-radius: 999rpx;
    box-shadow: 0 5rpx 0 #207a6e;
}

.sound-try::after {
    border: none;
}

.sound-status-tip {
    display: block;
    margin-top: 16rpx;
    font-size: 22rpx;
    color: #9c8c72;
    line-height: 1.6;
}

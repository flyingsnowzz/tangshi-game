/* 成长档案 · 少年国风：吉祥物 + 彩色数据贴纸 + 徽章阶梯 */
.profile {
    padding-top: 24rpx;
}

/* 我的称号横幅 */
.profile-hero {
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    padding: 24rpx 26rpx;
    background: #e2f5ef;
    border: 3rpx solid #8fd3c4;
    border-radius: 32rpx;
    box-shadow: 0 8rpx 0 #c6ecdf;
}

.profile-mascot {
    flex-shrink: 0;
    width: 132rpx;
    height: 132rpx;
    border-radius: 26rpx;
    background: #ffffff;
    border: 3rpx solid #ffffff;
}

.profile-hero-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin-left: 24rpx;
}

.profile-hero-hi {
    font-size: 22rpx;
    font-weight: 700;
    color: #4d8a7c;
    letter-spacing: 2rpx;
}

.profile-title {
    margin-top: 6rpx;
    font-size: 42rpx;
    font-weight: 800;
    letter-spacing: 3rpx;
    color: #207a6e;
}

.profile-desc {
    margin-top: 8rpx;
    font-size: 22rpx;
    color: #5f8379;
    line-height: 1.5;
}

.profile-hero-seal {
    position: absolute;
    top: -14rpx;
    right: -10rpx;
}

/* 下一称号进度 */
.next-title {
    box-sizing: border-box;
    margin-top: 28rpx;
    padding: 26rpx;
    background: #fff8e6;
    border: 3rpx dashed #f0c46a;
    border-radius: 28rpx;
}

.next-title-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18rpx;
}

.next-title-label {
    font-size: 27rpx;
    font-weight: 800;
    color: #8a5b12;
}

.next-title-need {
    font-size: 21rpx;
    color: #a08a5e;
}

.next-title-tip {
    display: block;
    margin-top: 14rpx;
    font-size: 22rpx;
    color: #a08a5e;
}

.top-title {
    margin-top: 26rpx;
    padding: 22rpx;
    text-align: center;
    font-size: 26rpx;
    font-weight: 800;
    color: #8a5b12;
    background: #ffd66b;
    border-radius: 26rpx;
    box-shadow: 0 6rpx 0 #f0c14a;
}

.stat-head,
.tier-head {
    margin-top: 44rpx;
}

/* 六色数据贴纸 */
.stat-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.stat-cell {
    box-sizing: border-box;
    width: calc(33.33% - 11rpx);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 26rpx 8rpx 22rpx;
    border: 3rpx solid;
    border-radius: 24rpx;
}

.stat-c1 { background: #e2f5ef; border-color: #8fd3c4; box-shadow: 0 6rpx 0 #c6ecdf; }
.stat-c2 { background: #fff0e2; border-color: #f6c99a; box-shadow: 0 6rpx 0 #f6d9bd; }
.stat-c3 { background: #fff6d8; border-color: #f0d79a; box-shadow: 0 6rpx 0 #f7e8bd; }
.stat-c4 { background: #ffeae3; border-color: #f3b8a9; box-shadow: 0 6rpx 0 #f8d6cb; }
.stat-c5 { background: #eaf2dd; border-color: #c6dba6; box-shadow: 0 6rpx 0 #dceac7; }
.stat-c6 { background: #e8eef7; border-color: #bccde4; box-shadow: 0 6rpx 0 #d4e0f0; }

.stat-value {
    font-size: 36rpx;
    font-weight: 800;
    color: #2b3a35;
    line-height: 1.2;
}

.stat-slash {
    font-size: 22rpx;
    font-weight: 600;
    color: #9aa39b;
}

.stat-unit {
    font-size: 22rpx;
    color: #6c7a72;
}

.stat-label {
    margin-top: 10rpx;
    font-size: 21rpx;
    color: #7d857c;
}

/* 正确率 */
.accuracy-box {
    box-sizing: border-box;
    margin-top: 22rpx;
    padding: 26rpx;
    background: #ffffff;
    border: 3rpx solid #f0e5cd;
    border-radius: 26rpx;
    box-shadow: 0 7rpx 0 #f4ead5;
}

.accuracy-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18rpx;
}

.accuracy-text {
    font-size: 23rpx;
    color: #6c7a72;
}

.accuracy-rate {
    font-size: 32rpx;
    font-weight: 800;
    color: #e2604f;
}

/* 称号阶梯：徽章化 */
.tier-list {
    box-sizing: border-box;
    padding: 10rpx 24rpx;
    background: #ffffff;
    border: 3rpx solid #f0e5cd;
    border-radius: 28rpx;
    box-shadow: 0 7rpx 0 #f4ead5;
}

.tier-item {
    display: flex;
    align-items: center;
    padding: 22rpx 0;
    border-bottom: 2rpx dashed #f0e5cd;
}

.tier-item:last-child {
    border-bottom: none;
}

.tier-badge {
    flex-shrink: 0;
    width: 76rpx;
    height: 76rpx;
    line-height: 76rpx;
    text-align: center;
    margin-right: 22rpx;
    font-size: 34rpx;
    font-weight: 800;
    color: #ffffff;
    border-radius: 22rpx;
}

.tier-badge-todo {
    background: #cfc9ba;
    box-shadow: 0 5rpx 0 #bcb5a4;
}

.tier-badge-done {
    background: #2f9e8f;
    box-shadow: 0 5rpx 0 #207a6e;
}

.tier-badge-current {
    background: #e2604f;
    box-shadow: 0 5rpx 0 #be473c;
}

.tier-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.tier-name {
    font-size: 28rpx;
    color: #9aa39b;
    font-weight: 700;
}

.tier-name-on {
    color: #2b3a35;
    font-weight: 800;
}

.tier-need {
    margin-top: 6rpx;
    font-size: 21rpx;
    color: #f5a340;
    font-weight: 700;
}

.tier-desc-tip {
    margin-top: 6rpx;
    font-size: 20rpx;
    color: #9aa39b;
    line-height: 1.4;
}

.tier-state {
    flex-shrink: 0;
    margin-left: 12rpx;
    padding: 6rpx 14rpx;
    font-size: 20rpx;
    font-weight: 800;
    border-radius: 18rpx;
}

.tier-state-todo {
    color: #9a9284;
    background: #f4ecdb;
}

.tier-state-done {
    color: #207a6e;
    background: #dff3ec;
}

.tier-state-current {
    color: #ffffff;
    background: #e2604f;
}

.profile-reset {
    margin-top: 48rpx;
    text-align: center;
    font-size: 23rpx;
    color: #9a9284;
}

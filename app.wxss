/* 唐诗闯关 · 少年国风全局样式
   面向小学与初中生：明快竹青 / 暖橙 / 鹅黄 / 朱砂，贴纸式粗圆角卡片，
   更大的按钮与字号、柔和彩色投影、轻量弹跳动效。无 emoji、无紫粉渐变、无外部字体。 */

page {
    min-height: 100%;
    background: #fffaf0;
    color: #2b3a35;
    font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

button::after {
    border: none;
}

/* 页面容器：暖米白 + 极淡圆点纸纹 */
.page-shell {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx 28rpx 88rpx;
    background-color: #fffaf0;
    background-image: radial-gradient(rgba(47, 158, 143, 0.075) 2rpx, transparent 2rpx);
    background-size: 30rpx 30rpx;
}

/* 贴纸式卡片 */
.paper-card {
    box-sizing: border-box;
    padding: 32rpx;
    background: #ffffff;
    border: 3rpx solid #f0e5cd;
    border-radius: 28rpx;
    box-shadow: 0 8rpx 0 rgba(240, 229, 205, 0.5), 0 14rpx 30rpx rgba(46, 80, 68, 0.07);
}

.paper-card-tight {
    padding: 24rpx;
}

/* 文字层级 */
.ink-title {
    font-size: 44rpx;
    font-weight: 800;
    letter-spacing: 2rpx;
    color: #2b3a35;
}

.ink-sub {
    font-size: 27rpx;
    color: #6c7a72;
    line-height: 1.7;
}

.muted {
    color: #9aa39b;
    font-size: 25rpx;
}

.ink-label {
    font-size: 28rpx;
    font-weight: 700;
    color: #207a6e;
}

/* 小标题：暖橙圆角竖条 */
.section-head {
    display: flex;
    align-items: center;
    margin-bottom: 22rpx;
}

.section-head::before {
    content: "";
    width: 10rpx;
    height: 32rpx;
    margin-right: 16rpx;
    background: #f5a340;
    border-radius: 8rpx;
}

.section-head-text {
    font-size: 33rpx;
    font-weight: 800;
    letter-spacing: 2rpx;
    color: #2b3a35;
}

.section-head-extra {
    margin-left: auto;
    font-size: 25rpx;
    color: #9aa39b;
}

/* 印章 */
.seal {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68rpx;
    height: 68rpx;
    background: #e2604f;
    color: #fffaf0;
    font-size: 32rpx;
    line-height: 1;
    border-radius: 16rpx;
    letter-spacing: 2rpx;
    box-shadow: 0 6rpx 0 rgba(190, 71, 60, 0.35);
}

.seal-small {
    width: 50rpx;
    height: 50rpx;
    font-size: 24rpx;
    border-radius: 12rpx;
}

/* 分隔线 */
.rule {
    height: 2rpx;
    margin: 28rpx 0;
    background: #f0e5cd;
}

/* 按钮：大圆角 + 底部实色厚度 */
.btn-primary,
.btn-ghost,
.btn-quiet {
    box-sizing: border-box;
    height: 96rpx;
    line-height: 90rpx;
    padding: 0 32rpx;
    font-size: 31rpx;
    font-weight: 700;
    border-radius: 48rpx;
    letter-spacing: 2rpx;
}

.btn-primary {
    background: #2f9e8f;
    color: #ffffff;
    border: 3rpx solid #2f9e8f;
    box-shadow: 0 7rpx 0 #207a6e;
}

.btn-ghost {
    background: #ffffff;
    color: #207a6e;
    border: 3rpx solid #8fd3c4;
    box-shadow: 0 7rpx 0 #dff3ec;
}

.btn-quiet {
    background: #fff3dc;
    color: #8a6320;
    border: 3rpx solid #f0d79a;
    box-shadow: 0 7rpx 0 #f7e3bb;
}

.btn-row {
    display: flex;
    gap: 20rpx;
    margin-top: 28rpx;
    margin-bottom: 12rpx;
}

.btn-row > button {
    flex: 1;
}

/* 星级 */
.stars {
    display: flex;
    align-items: center;
}

.star-on {
    color: #f5a340;
    font-size: 32rpx;
}

.star-off {
    color: #e3ddcd;
    font-size: 32rpx;
}

/* 进度条 */
.progress-track {
    height: 18rpx;
    background: #f3ead6;
    border-radius: 18rpx;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #2f9e8f, #7ccfb4);
    border-radius: 18rpx;
    transition: width 320ms ease-out;
}

/* 标签胶囊 */
.tag {
    display: inline-block;
    padding: 6rpx 18rpx;
    font-size: 23rpx;
    color: #207a6e;
    background: #dff3ec;
    border-radius: 24rpx;
}

.tag-red {
    color: #c14c3d;
    background: #ffe8e1;
}

.tag-gray {
    color: #8a8b80;
    background: #f4ecdb;
}

/* 空态 */
.empty-box {
    padding: 72rpx 24rpx;
    text-align: center;
}

.empty-title {
    font-size: 32rpx;
    font-weight: 700;
    color: #6c7a72;
}

.empty-desc {
    margin-top: 16rpx;
    font-size: 26rpx;
    color: #9aa39b;
    line-height: 1.7;
}

/* 内容加载 / 异常（游客不拦截） */
.cloud-gate {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 170rpx;
    text-align: center;
}

.cloud-emblem {
    width: 116rpx;
    height: 116rpx;
    line-height: 116rpx;
    text-align: center;
    background: #e2604f;
    color: #fffaf0;
    font-size: 58rpx;
    border-radius: 32rpx;
    border: 6rpx solid #ffffff;
    box-shadow: 0 10rpx 0 rgba(190, 71, 60, 0.3);
    margin-bottom: 40rpx;
    animation: float 2.2s ease-in-out infinite;
}

.cloud-title {
    font-size: 48rpx;
    font-weight: 800;
    letter-spacing: 6rpx;
    color: #2b3a35;
}

.cloud-note {
    display: block;
    margin-top: 24rpx;
    max-width: 560rpx;
    font-size: 28rpx;
    line-height: 1.8;
    color: #6c7a72;
}

.cloud-note-error {
    color: #c14c3d;
}

.cloud-btn {
    margin-top: 40rpx;
    width: 320rpx;
}

/* 账号状态 */
.account-box {
    margin-top: 8rpx;
}

.account-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.account-text {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.account-name {
    font-size: 30rpx;
    font-weight: 800;
    color: #2b3a35;
}

.account-desc {
    margin-top: 10rpx;
    font-size: 25rpx;
    color: #8a8b80;
    line-height: 1.6;
}

.account-btn {
    flex-shrink: 0;
    height: 72rpx;
    line-height: 68rpx;
    padding: 0 26rpx;
    font-size: 26rpx;
    color: #c14c3d;
    background: #ffffff;
    border: 3rpx solid #f3c7bd;
    border-radius: 36rpx;
}

/* ---- 结算页：诗签收集 ---- */
.sign-box {
    margin-top: 26rpx;
}

.sign-row {
    display: flex;
    gap: 16rpx;
}

.sign-item {
    flex: 1;
    min-width: 0;
    background: #fffaf0;
    border: 3rpx solid #f0e5cd;
    border-radius: 20rpx;
    padding: 10rpx;
    animation: pop-in 320ms ease-out both;
}

.sign-img {
    display: block;
    width: 100%;
    border-radius: 12rpx;
}

.sign-name {
    display: block;
    margin-top: 10rpx;
    font-size: 22rpx;
    text-align: center;
    color: #6c7a72;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sign-tip {
    display: block;
    margin-top: 18rpx;
    font-size: 24rpx;
    color: #9aa39b;
}

/* ---- 结算页：成绩保存卡（唯一登录入口） ---- */
.save-card {
    box-sizing: border-box;
    display: flex;
    align-items: center;
    margin-top: 26rpx;
    padding: 26rpx;
    background: #fff3dc;
    border: 3rpx dashed #f0c46a;
    border-radius: 28rpx;
}

.save-done {
    background: #dff3ec;
    border: 3rpx solid #8fd3c4;
}

.save-icon {
    flex-shrink: 0;
    width: 76rpx;
    height: 76rpx;
    line-height: 76rpx;
    text-align: center;
    font-size: 32rpx;
    font-weight: 800;
    color: #ffffff;
    background: #f5a340;
    border-radius: 22rpx;
    margin-right: 22rpx;
}

.save-icon-done {
    background: #2f9e8f;
}

.save-text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.save-title {
    font-size: 29rpx;
    font-weight: 800;
    color: #2b3a35;
}

.save-desc {
    margin-top: 8rpx;
    font-size: 24rpx;
    line-height: 1.6;
    color: #8a7b5c;
}

.save-done .save-desc {
    color: #5f8379;
}

.save-btn {
    flex-shrink: 0;
    height: 72rpx;
    line-height: 72rpx;
    padding: 0 26rpx;
    font-size: 26rpx;
    font-weight: 800;
    color: #ffffff;
    background: #e2604f;
    border-radius: 36rpx;
    box-shadow: 0 6rpx 0 #be473c;
}

/* ---- 答题页：连对鼓励 ---- */
.combo-tip {
    margin: 20rpx auto 0;
    padding: 12rpx 30rpx;
    width: fit-content;
    font-size: 27rpx;
    font-weight: 800;
    color: #8a6320;
    background: #ffd66b;
    border-radius: 30rpx;
    animation: star-pop 380ms ease-out;
}

/* ---- 动效 ---- */
@keyframes pop-in {
    from { opacity: 0; transform: translateY(20rpx) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes star-pop {
    0%   { transform: scale(0.6); opacity: 0; }
    70%  { transform: scale(1.18); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50%      { transform: translateY(-10rpx); }
}

/* ---- 转发给同学的显式入口（所有页面通用） ---- */
.share-btn {
    display: block;
    box-sizing: border-box;
    width: 100%;
    margin: 26rpx 0 0;
    padding: 20rpx 24rpx;
    font-size: 28rpx;
    font-weight: 800;
    line-height: 1.4;
    color: #a8631b;
    text-align: center;
    background: #fff3dc;
    border: 3rpx dashed #f0c46a;
    border-radius: 22rpx;
}

.share-btn::after {
    border: none;
}

.share-tip {
    display: block;
    margin-top: 12rpx;
    font-size: 22rpx;
    line-height: 1.5;
    color: #9c8c72;
    text-align: center;
}
